# Copy this file to .env and fill in the required fields.

# LightlyStudio server
# LIGHTLY_STUDIO_PROTOCOL=http
# LIGHTLY_STUDIO_HOST=0.0.0.0
# LIGHTLY_STUDIO_PORT=8001

# Debug
# LIGHTLY_STUDIO_DEBUG=false

# Embedding model cache dir, defaults to user/.cache/lightly-studio.
# LIGHTLY_STUDIO_MODEL_CACHE_DIR="/Users/username/.cache/lightly-studio"

# Anonymous usage tracking.
#
# A checkout reports to the dev PostHog project and a released package to the production one,
# from the cohort of the installation, so nothing here has to be set.
#
# Report to another project instead, overriding that.
# LIGHTLY_STUDIO_POSTHOG_KEY=phc_yourkey
#
# Set to false to switch tracking off entirely, in the Python package and the GUI.
# LIGHTLY_STUDIO_ANALYTICS_ENABLED=false
#
# Lightly staff: mark this run as internal, so it is filtered out of the product metrics.
# CONTRIBUTING.md has the marker file, which marks the machine for good.
# LIGHTLY_STUDIO_INTERNAL=1

# Example script dataset paths
EXAMPLES_DATASET_PATH="datasets/coco_subset_128_images/images"
EXAMPLES_YOLO_YAML_PATH="datasets/road_signs_yolo/data.yaml"
EXAMPLES_YOLO_SPLIT="train"
EXAMPLES_COCO_JSON_PATH="datasets/coco_subset_128_images/instances_train2017.json"
EXAMPLES_PRED_ANNOTATIONS_JSON="datasets/coco_subset_128_images/predictions_train2017.json"
EXAMPLES_COCO_IMAGES_PATH="datasets/coco_subset_128_images/images"
EXAMPLES_COCO_CAPTION_JSON_PATH="datasets/coco_subset_128_images/captions_train2017.json"
EXAMPLES_COCO_CAPTION_IMAGES_PATH="datasets/coco_subset_128_images/images"
EXAMPLES_LIGHTLY_PREDICTIONS="datasets/coco_subset_128_images/predictions"
EXAMPLES_VIDEO_DATASET_PATH="datasets/youtube_vis_50_videos/train/videos"
EXAMPLES_VIDEO_YVIS_JSON_PATH="datasets/youtube_vis_50_videos/train/instances_50.json"
EXAMPLES_PASCALVOC_IMAGES_PATH="datasets/voc2012_10_images/JPEGImages"
EXAMPLES_PASCALVOC_MASKS_PATH="datasets/voc2012_10_images/SegmentationClass"
EXAMPLES_PASCALVOC_PRED_MASKS_PATH="datasets/voc2012_10_images/SegmentationClassPredictions"
EXAMPLES_PASCALVOC_CATEGORIES_JSON_PATH="datasets/voc2012_10_images/class_id_to_name.json"
EXAMPLES_MIDV_PATH="datasets/midv_2020_10_samples"
EXAMPLES_ACTIVITYNET_VIDEOS_PATH="datasets/activitynet_10_videos/videos"
EXAMPLES_ACTIVITYNET_JSON_PATH="datasets/activitynet_10_videos/activity_net.v1-3.min.json"

# Request timing for endpoint functionality.
# 
# Flag enabling request timing middleware.
# LIGHTLY_STUDIO_REQUEST_TIMING_ENABLED=true
# 
# Flag to control request timing (Default is 200ms)
# LIGHTLY_STUDIO_REQUEST_TIMING_ERROR_MS=
#
# Flag to control whether requests that exceed the error threshold should be failed with a 503 response.
# LIGHTLY_STUDIO_REQUEST_TIMING_FAIL_ON_ERROR=true

